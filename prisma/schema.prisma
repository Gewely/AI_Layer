generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole { OWNER ADMIN EDITOR VIEWER }
enum FrictionCategory { FORM_FRICTION CTA_WEAKNESS HIERARCHY_CLARITY TRUST_GAP MOBILE_DENSITY DEAD_OR_RAGE_CLICK PAYOFF_TOO_LATE STEP_LEAKAGE CONTENT_OVERLOAD NEXT_STEP_GUIDANCE }
enum RecommendationLabel { QUICK_WIN STRATEGIC }
enum RecommendationStatus { DRAFT PROPOSED ACCEPTED IN_PROGRESS RELEASED REJECTED }

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  passwordHash    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  workspaceMember WorkspaceMember[]
  sessions        Session[]
  auditLogs       AuditLog[]
}
model Workspace {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  members           WorkspaceMember[]
  websites          Website[]
  clarityConnection ClarityConnection?
  jiraConnection    JiraConnection?
  figmaConnection   FigmaConnection?
  tags              Tag[]
  recommendations   Recommendation[]
  frictionIssues    FrictionIssue[]
  jobLogs           JobLog[]
  auditLogs         AuditLog[]
}
model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}
model Website {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  domain       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments Environment[]
  pages        Page[]
  journeys     Journey[]
  components   Component[]
}
model Environment {
  id        String    @id @default(cuid())
  websiteId String
  name      String
  sdkKey    String    @unique
  createdAt DateTime  @default(now())
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sessions  Session[]
}
model Page {
  id             String          @id @default(cuid())
  websiteId      String
  path           String
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  journeySteps   JourneyStep[]
  pageComponents PageComponent[]
  @@unique([websiteId, path])
}
model Journey {
  id        String        @id @default(cuid())
  websiteId String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  website   Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  steps     JourneyStep[]
}
model JourneyStep {
  id        String   @id @default(cuid())
  journeyId String
  pageId    String?
  name      String
  position  Int
  createdAt DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  @@unique([journeyId, position])
}
model Component {
  id        String          @id @default(cuid())
  websiteId String
  selector  String
  label     String?
  createdAt DateTime        @default(now())
  website   Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pageLinks PageComponent[]
}
model PageComponent {
  id          String    @id @default(cuid())
  pageId      String
  componentId String
  createdAt   DateTime  @default(now())
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  @@unique([pageId, componentId])
}
model Session {
  id            String       @id @default(cuid())
  userId        String?
  environmentId String?
  externalId    String       @unique
  startedAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  events        Event[]
}
model Event {
  id        String   @id @default(cuid())
  sessionId String
  pagePath  String?
  component String?
  eventType String
  payload   Json?
  timestamp DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, name])
}
model ClarityConnection {
  id              String            @id @default(cuid())
  workspaceId     String            @unique
  projectId       String
  apiKeyEncrypted String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importJobs      ClarityImportJob[]
}
model ClarityImportJob {
  id                  String           @id @default(cuid())
  clarityConnectionId String
  status              String
  startedAt           DateTime         @default(now())
  completedAt         DateTime?
  clarityConnection   ClarityConnection @relation(fields: [clarityConnectionId], references: [id], onDelete: Cascade)
  evidences           ClarityEvidence[]
}
model ClarityEvidence {
  id          String                @id @default(cuid())
  importJobId String
  sessionRef  String
  signalType  String
  summary     String
  metadata    Json?
  importJob   ClarityImportJob      @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  issueLinks  FrictionEvidenceLink[]
}
model FrictionIssue {
  id              String               @id @default(cuid())
  workspaceId     String
  websiteId       String?
  title           String
  description     String
  category        FrictionCategory
  severityScore   Int
  impactScore     Int
  effortScore     Int
  detectedAt      DateTime             @default(now())
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidenceLinks   FrictionEvidenceLink[]
  recommendations Recommendation[]
}
model FrictionEvidenceLink {
  id                String          @id @default(cuid())
  frictionIssueId   String
  clarityEvidenceId String
  frictionIssue     FrictionIssue   @relation(fields: [frictionIssueId], references: [id], onDelete: Cascade)
  clarityEvidence   ClarityEvidence @relation(fields: [clarityEvidenceId], references: [id], onDelete: Cascade)
  @@unique([frictionIssueId, clarityEvidenceId])
}
model Recommendation {
  id                   String               @id @default(cuid())
  workspaceId          String
  frictionIssueId      String
  title                String
  status               RecommendationStatus @default(DRAFT)
  priorityScore        Int
  label                RecommendationLabel
  problemStatement     String
  evidenceSummary      String
  likelyCauses         String
  proposedFix          String
  expectedImpact       String
  implementationDetail String
  acceptanceCriteria   String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  frictionIssue        FrictionIssue        @relation(fields: [frictionIssueId], references: [id], onDelete: Cascade)
  versions             RecommendationVersion[]
  jiraLinks            JiraIssueLink[]
  figmaNodeLinks       FigmaNodeLink[]
}
model RecommendationVersion {
  id               String         @id @default(cuid())
  recommendationId String
  version          Int
  content          Json
  createdAt        DateTime       @default(now())
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@unique([recommendationId, version])
}
model JiraConnection {
  id                String             @id @default(cuid())
  workspaceId       String             @unique
  baseUrl           String
  email             String
  apiTokenEncrypted String
  createdAt         DateTime           @default(now())
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectMappings   JiraProjectMapping[]
}
model JiraProjectMapping {
  id               String          @id @default(cuid())
  jiraConnectionId String
  websiteId        String?
  jiraProjectKey   String
  jiraIssueType    String
  jiraConnection   JiraConnection  @relation(fields: [jiraConnectionId], references: [id], onDelete: Cascade)
  issueLinks       JiraIssueLink[]
}
model JiraIssueLink {
  id                   String             @id @default(cuid())
  recommendationId     String
  jiraProjectMappingId String
  jiraIssueKey         String
  jiraIssueUrl         String
  syncedAt             DateTime           @default(now())
  recommendation       Recommendation     @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  jiraProjectMapping   JiraProjectMapping @relation(fields: [jiraProjectMappingId], references: [id], onDelete: Cascade)
}
model FigmaConnection {
  id                   String          @id @default(cuid())
  workspaceId          String          @unique
  accessTokenEncrypted String
  createdAt            DateTime        @default(now())
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileLinks            FigmaFileLink[]
}
model FigmaFileLink {
  id                String         @id @default(cuid())
  figmaConnectionId String
  websiteId         String?
  fileKey           String
  fileName          String
  figmaConnection   FigmaConnection @relation(fields: [figmaConnectionId], references: [id], onDelete: Cascade)
  nodeLinks         FigmaNodeLink[]
}
model FigmaNodeLink {
  id               String         @id @default(cuid())
  figmaFileLinkId  String
  recommendationId String
  nodeId           String
  nodeName         String
  figmaUrl         String
  figmaFileLink    FigmaFileLink  @relation(fields: [figmaFileLinkId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}
model JobLog {
  id          String     @id @default(cuid())
  workspaceId String?
  jobType     String
  status      String
  detail      String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}
model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  entityType  String
  entityId    String
  detail      Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}
